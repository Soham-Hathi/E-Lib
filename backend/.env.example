# Server Settings
PORT=3000
NODE_ENV=development

# Database Configuration (Atlas or Local MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/bookstore

# JWT Authentication Signing Key
JWT_SECRET_KEY=replace_with_a_64_character_random_hex_string
JWT_EXPIRES_IN=7d

# CORS Allowed Origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Razorpay Payment Gateway (India-First)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=replace_with_your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_your_webhook_secret

# AI & LLM (Google Gemini Flash 1.5)
GEMINI_API_KEY=replace_with_your_google_gemini_api_key

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Delivery (SMTP / Nodemailer)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password
ADMIN_EMAIL=admin@yourdomain.com
